DATABASE_URL="postgresql://depenses_app:CHANGE_ME@localhost:5432/depenses_dev?schema=public"
JWT_ACCESS_SECRET="change_me"
JWT_REFRESH_SECRET="change_me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
PORT=3000
NODE_ENV=development

# Envoi du code OTP de vérification email (facultatif) — si SMTP_HOST est absent,
# MailerService journalise le code au lieu de l'envoyer (dev/CI sans fournisseur email).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
