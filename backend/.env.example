DATABASE_URL="postgresql://depenses_app:CHANGE_ME@localhost:5432/depenses_dev?schema=public"
JWT_ACCESS_SECRET="change_me"
JWT_REFRESH_SECRET="change_me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
PORT=3000
NODE_ENV=development

# Envoi du code OTP de vérification email (facultatif) — si RESEND_API_KEY est
# absent, le code est journalisé côté serveur au lieu d'être envoyé (dev/CI/tests).
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Origines autorisées pour les requêtes cross-origin (Web/PWA), séparées par
# des virgules (ex. "https://app.d-penses.example,https://d-penses.example").
# Obligatoire en production (NODE_ENV=production) — jamais de wildcard "*".
# Facultatif hors production : si absent, comportement permissif conservé
# pour le dev local (n'affecte pas le mobile natif, qui n'envoie pas
# d'en-tête Origin).
CORS_ORIGINS=
