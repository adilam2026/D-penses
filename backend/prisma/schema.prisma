// Finance Maison — reconstruction totale (reset 2026-09-27).
// Ancien socle métier archivé sur la branche `archive/legacy-d-penses-2026-09-27`.
// Seule l'infrastructure technique (auth/foyer/session) est conservée à l'identique.
// Schéma métier V3.1 : comptabilité en partie double via ledger_entries, aucune
// balance stockée (toujours dérivée), aucune ambiguïté prévu/réalisé (cf. rapport
// de reset — display() vs budget(), effective_amount, invariants non-affecté/solde).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// SOCLE — infrastructure technique conservée à l'identique (jamais touchée par le reset)
// ============================================================

enum HouseholdRole {
  admin
  member
  read_only
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  passwordHash      String     @map("password_hash")
  firstName         String     @map("first_name")
  lastName          String     @map("last_name")
  avatarUrl         String?    @map("avatar_url")
  color             String?    @map("color")
  emailVerifiedAt   DateTime?  @map("email_verified_at")
  activeHouseholdId String?    @map("active_household_id")
  activeHousehold   Household? @relation(fields: [activeHouseholdId], references: [id], onDelete: SetNull)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  memberships                HouseholdMembership[]
  sessions                   Session[]
  emailOtps                  EmailOtp[]
  createdInvites             HouseholdInvite[] @relation("InviteCreatedBy")
  redeemedInvites            HouseholdInvite[] @relation("InviteRedeemedBy")
  createdFinancialOperations FinancialOperation[]

  @@map("user")
}

model Household {
  id        String   @id @default(uuid())
  name      String
  currency  String   @default("MAD")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships         HouseholdMembership[]
  usersWithThisActive User[]
  invites             HouseholdInvite[]

  accounts            Account[]
  subaccounts         Subaccount[]
  categories          Category[]
  recurrenceRules     RecurrenceRule[]
  financialPlans      FinancialPlan[]
  goals               Goal[]
  financialOperations FinancialOperation[]
  plannedOperations   PlannedOperation[]
  medicalClaims       MedicalClaim[]

  @@map("household")
}

model HouseholdMembership {
  id          String        @id @default(uuid())
  householdId String        @map("household_id")
  userId      String        @map("user_id")
  role        HouseholdRole
  joinedAt    DateTime      @default(now()) @map("joined_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  ownedAccounts Account[]

  @@unique([householdId, userId])
  @@map("household_membership")
}

model HouseholdInvite {
  id          String        @id @default(uuid())
  householdId String        @map("household_id")
  code        String        @unique
  role        HouseholdRole @default(admin)
  createdById String        @map("created_by_id")
  expiresAt   DateTime      @map("expires_at")
  usedAt      DateTime?     @map("used_at")
  usedById    String?       @map("used_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User      @relation("InviteCreatedBy", fields: [createdById], references: [id])
  usedBy    User?     @relation("InviteRedeemedBy", fields: [usedById], references: [id])

  @@map("household_invite")
}

model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")
  revokedAt        DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model EmailOtp {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_otp")
}

// ============================================================
// FINANCE MAISON — schéma métier V3.1 (validé, cf. rapport de reset)
// ============================================================

enum AccountType {
  COURANT
  EPARGNE
  ESPECES
  AUTRE
}

// Nature économique de l'opération — jamais confondue avec la mécanique
// comptable (ledger_entries) ni avec le traitement budgétaire (budget_impact).
enum OperationKind {
  EXPENSE
  INCOME
  TRANSFER
  SAVINGS_CONTRIBUTION
  MEDICAL_REIMBURSEMENT
  OPENING_BALANCE
}

// Sous-ensemble de OperationKind : TRANSFER/MEDICAL_REIMBURSEMENT/OPENING_BALANCE
// n'existent jamais à l'état "planifié" (cf. tableau de contraintes du rapport).
enum PlannedOperationKind {
  EXPENSE
  INCOME
  SAVINGS_CONTRIBUTION
}

// Renseigné uniquement pour EXPENSE/SAVINGS_CONTRIBUTION avec source_subaccount_id :
// détermine si la dépense est already-funded (SUBACCOUNT) ou impacte le budget
// courant (DIRECT). NULL pour les kinds où la question ne se pose pas (INCOME,
// TRANSFER, MEDICAL_REIMBURSEMENT, OPENING_BALANCE).
enum FinancedFrom {
  DIRECT
  SUBACCOUNT
}

// Filtre UNIQUEMENT l'agrégat budget() (Total Revenus/Dépenses/Épargne/Balance).
// Ne filtre JAMAIS display() (ce que l'utilisateur voit dans une cellule Planning,
// l'historique, le détail catégorie) — cf. bug corrigé §V3→V3.1 du rapport.
enum BudgetImpact {
  NORMAL
  ALREADY_FUNDED
  EXCLUDED
}

enum PlannedOperationStatus {
  PENDING
  REALIZED
  CANCELLED
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
  ONCE
}

model Account {
  id            String      @id @default(uuid())
  householdId   String      @map("household_id")
  name          String
  bank          String?
  type          AccountType @default(COURANT)
  ownerMemberId String?     @map("owner_member_id")
  ownerLabel    String?     @map("owner_label")
  active        Boolean     @default(true)
  // Couleur de carte choisie par l'utilisateur (Lot ciblé §1) — une des ~10 clés de palette prédéfinie, jamais un hex libre. Null = compte créé avant cette fonctionnalité, rotation automatique côté mobile.
  colorKey      String?     @map("color_key")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  household   Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ownerMember HouseholdMembership? @relation(fields: [ownerMemberId], references: [id], onDelete: SetNull)

  subaccounts   Subaccount[]
  ledgerEntries LedgerEntry[]
  goals         Goal[]

  operationsAsSource      FinancialOperation[] @relation("OperationSourceAccount")
  operationsAsDestination FinancialOperation[] @relation("OperationDestinationAccount")

  plannedAsSource      PlannedOperation[] @relation("PlannedSourceAccount")
  plannedAsDestination PlannedOperation[] @relation("PlannedDestinationAccount")

  recurrenceRulesAsSource      RecurrenceRule[] @relation("RecurrenceSourceAccount")
  recurrenceRulesAsDestination RecurrenceRule[] @relation("RecurrenceDestinationAccount")

  financialPlans FinancialPlan[] @relation("PlanAccount")

  @@index([householdId])
  @@map("account")
}

// Le solde d'un sous-compte n'est JAMAIS stocké : toujours
// SUM(ledger_entries.amount WHERE subaccount_id = X).
model Subaccount {
  id          String   @id @default(uuid())
  accountId   String   @map("account_id")
  householdId String   @map("household_id")
  name        String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  ledgerEntries LedgerEntry[]
  goals         Goal[]

  operationsAsSourceSub      FinancialOperation[] @relation("OperationSourceSubaccount")
  operationsAsDestinationSub FinancialOperation[] @relation("OperationDestinationSubaccount")

  plannedAsSourceSub      PlannedOperation[] @relation("PlannedSourceSubaccount")
  plannedAsDestinationSub PlannedOperation[] @relation("PlannedDestinationSubaccount")

  medicalClaims                MedicalClaim[]
  medicalReimbursementsAllocated MedicalReimbursement[] @relation("ReimbursementAllocationSubaccount")

  recurrenceRulesAsSourceSub      RecurrenceRule[] @relation("RecurrenceSourceSubaccount")
  recurrenceRulesAsDestinationSub RecurrenceRule[] @relation("RecurrenceDestinationSubaccount")

  financialPlans FinancialPlan[] @relation("PlanSubaccount")

  @@index([accountId])
  @@index([householdId])
  @@map("subaccount")
}

// "Autres" est le seul enregistrement avec isDefaultFallback=true : auto-seedé,
// jamais supprimable (contrôlé au niveau service, pas par une contrainte DB).
model Category {
  id                String   @id @default(uuid())
  householdId       String   @map("household_id")
  name              String
  active            Boolean  @default(true)
  sortOrder         Int      @default(0) @map("sort_order")
  isDefaultFallback Boolean  @default(false) @map("is_default_fallback")
  createdAt         DateTime @default(now()) @map("created_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  financialOperations FinancialOperation[]
  plannedOperations   PlannedOperation[]
  recurrenceRules     RecurrenceRule[]

  @@index([householdId])
  @@map("category")
}

// Une règle de récurrence n'est jamais une occurrence : chaque échéance réelle
// est une ligne planned_operations distincte, garantie unique par
// @@unique([recurrenceRuleId, expectedDate]) (idempotence de génération).
//
// Porte le GABARIT de génération (kind/montant/catégorie/comptes) — chaque
// planned_operation générée copie ces valeurs à sa création, puis vit de
// façon indépendante : modifier UNE occurrence ne touche jamais ce gabarit ;
// modifier le gabarit avec "cette occurrence et les suivantes" met à jour ce
// gabarit ET les occurrences PENDING à partir de la date pivot, jamais
// l'historique déjà réalisé (Checkpoint 3 §18/§19).
model RecurrenceRule {
  id          String              @id @default(uuid())
  householdId String              @map("household_id")
  frequency   RecurrenceFrequency
  anchorDate  DateTime            @map("anchor_date") @db.Date
  label       String?
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now()) @map("created_at")

  kind           PlannedOperationKind @default(EXPENSE)
  expectedAmount Decimal              @default(0) @map("expected_amount") @db.Decimal(14, 2)
  categoryId     String?              @map("category_id")

  financialPlanItemId     String? @map("financial_plan_item_id")
  financialPlanDeadlineId String? @map("financial_plan_deadline_id")

  sourceAccountId         String? @map("source_account_id")
  sourceSubaccountId      String? @map("source_subaccount_id")
  destinationAccountId    String? @map("destination_account_id")
  destinationSubaccountId String? @map("destination_subaccount_id")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  financialPlanItem     FinancialPlanItem?     @relation(fields: [financialPlanItemId], references: [id])
  financialPlanDeadline FinancialPlanDeadline? @relation(fields: [financialPlanDeadlineId], references: [id])

  sourceAccount         Account?    @relation("RecurrenceSourceAccount", fields: [sourceAccountId], references: [id])
  sourceSubaccount      Subaccount? @relation("RecurrenceSourceSubaccount", fields: [sourceSubaccountId], references: [id])
  destinationAccount    Account?    @relation("RecurrenceDestinationAccount", fields: [destinationAccountId], references: [id])
  destinationSubaccount Subaccount? @relation("RecurrenceDestinationSubaccount", fields: [destinationSubaccountId], references: [id])

  plannedOperations PlannedOperation[]

  @@index([householdId])
  @@map("recurrence_rule")
}

model FinancialPlan {
  id           String   @id @default(uuid())
  householdId  String   @map("household_id")
  label        String
  accountId    String?  @map("account_id")
  subaccountId String?  @map("subaccount_id")
  createdAt    DateTime @default(now()) @map("created_at")

  household  Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account    Account?    @relation("PlanAccount", fields: [accountId], references: [id], onDelete: SetNull)
  subaccount Subaccount? @relation("PlanSubaccount", fields: [subaccountId], references: [id], onDelete: SetNull)

  items     FinancialPlanItem[]
  deadlines FinancialPlanDeadline[]

  @@index([householdId])
  @@map("financial_plan")
}

// expectedAmount/frequency : gabarit optionnel d'un élément récurrent (§14 Checkpoint 4)
// — un élément non récurrent (frequency=ONCE) n'est jamais généré automatiquement,
// il est ajouté explicitement à UNE échéance (cf. financial-plans.service#addItemToDeadline).
model FinancialPlanItem {
  id             String               @id @default(uuid())
  planId         String               @map("plan_id")
  label          String
  expectedAmount Decimal?             @map("expected_amount") @db.Decimal(14, 2)
  frequency      RecurrenceFrequency  @default(ONCE)
  active         Boolean              @default(true)

  plan              FinancialPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  plannedOperations PlannedOperation[]
  recurrenceRules   RecurrenceRule[]

  @@index([planId])
  @@map("financial_plan_item")
}

// Le montant propre de l'échéance (expectedAmount) est le montant à payer
// pour CETTE échéance, indépendamment des postes du plan — les deux sont
// additifs (jamais un remplaçant de l'autre) : le total prévu d'une échéance
// reste TOUJOURS dérivé en sommant ses planned_operations (jamais stocké
// directement, cf. computeDeadlineSummary), mais expectedAmount est
// maintenant reflété par une planned_operation "sans poste"
// (financialPlanItemId: null) créée/mise à jour en même temps que ce champ,
// pour qu'il alimente ce calcul existant sans jamais être sommé deux fois.
model FinancialPlanDeadline {
  id             String   @id @default(uuid())
  planId         String   @map("plan_id")
  label          String
  dueDate        DateTime @map("due_date") @db.Date
  expectedAmount Decimal? @map("expected_amount") @db.Decimal(14, 2)

  plan              FinancialPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  plannedOperations PlannedOperation[]
  recurrenceRules   RecurrenceRule[]

  @@index([planId])
  @@map("financial_plan_deadline")
}

// Exactement l'un de accountId/subaccountId est renseigné (contrôlé au niveau service).
model Goal {
  id           String    @id @default(uuid())
  householdId  String    @map("household_id")
  accountId    String?   @map("account_id")
  subaccountId String?   @map("subaccount_id")
  targetAmount Decimal   @map("target_amount") @db.Decimal(14, 2)
  targetDate   DateTime? @map("target_date") @db.Date
  label        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  household  Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account    Account?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  subaccount Subaccount? @relation(fields: [subaccountId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("goal")
}

// Fait économique immuable. `amount` est TOUJOURS positif — un renversement ne
// modifie jamais cette ligne, il crée une nouvelle ligne avec
// reversalOfOperationId renseigné (effective_amount = -amount dans ce cas,
// calculé en application, jamais stocké). Contraintes par kind (source/
// destination account/subaccount requis|interdit|optionnel) appliquées en
// application + trigger DB (cf. tableau du rapport de reset).
model FinancialOperation {
  id          String        @id @default(uuid())
  householdId String        @map("household_id")
  kind        OperationKind
  label       String
  date        DateTime      @db.Date
  amount      Decimal       @db.Decimal(14, 2)
  categoryId  String?       @map("category_id")

  sourceAccountId         String? @map("source_account_id")
  sourceSubaccountId      String? @map("source_subaccount_id")
  destinationAccountId    String? @map("destination_account_id")
  destinationSubaccountId String? @map("destination_subaccount_id")

  financedFrom FinancedFrom? @map("financed_from")
  budgetImpact BudgetImpact  @default(NORMAL) @map("budget_impact")

  reversalOfOperationId String? @map("reversal_of_operation_id")
  reversalReason        String? @map("reversal_reason")

  // "Modifier" une opération réalisée (§4) : jamais de mutation d'une ligne
  // historique. La correction crée deux nouvelles opérations — un reversal de
  // l'originale (reversalOfOperationId) et une nouvelle opération corrigée
  // (correctionOfOperationId pointant vers l'ORIGINALE) — pour garder une
  // chaîne d'audit explicite et traçable en base, pas seulement par libellé.
  correctionOfOperationId String? @map("correction_of_operation_id")

  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  sourceAccount         Account?    @relation("OperationSourceAccount", fields: [sourceAccountId], references: [id])
  sourceSubaccount      Subaccount? @relation("OperationSourceSubaccount", fields: [sourceSubaccountId], references: [id])
  destinationAccount    Account?    @relation("OperationDestinationAccount", fields: [destinationAccountId], references: [id])
  destinationSubaccount Subaccount? @relation("OperationDestinationSubaccount", fields: [destinationSubaccountId], references: [id])

  createdByUser User @relation(fields: [createdByUserId], references: [id])

  reversalOfOperation FinancialOperation?  @relation("OperationReversal", fields: [reversalOfOperationId], references: [id])
  reversals           FinancialOperation[] @relation("OperationReversal")

  correctionOfOperation FinancialOperation?  @relation("OperationCorrection", fields: [correctionOfOperationId], references: [id])
  correctedByOperations FinancialOperation[] @relation("OperationCorrection")

  ledgerEntries         LedgerEntry[]
  realizesPlannedOps    PlannedOperation[]
  medicalClaimsSourced  MedicalClaim[]
  medicalReimbursements MedicalReimbursement[]

  @@index([householdId])
  @@index([reversalOfOperationId])
  @@index([correctionOfOperationId])
  @@map("financial_operation")
}

// Mécanique comptable pure — AUCUNE sémantique (pas de category_id ici). Un
// FinancialOperation peut produire 1 à 3 lignes (cf. exemples 1-10 du rapport :
// un versement cross-compte génère 3 lignes ledger pour 1 seule opération).
// affects_account_balance=false = mouvement purement interne à l'allocation
// (création/versement de sous-compte), qui ne change jamais account.balance.
model LedgerEntry {
  id                    String   @id @default(uuid())
  financialOperationId  String   @map("financial_operation_id")
  accountId             String   @map("account_id")
  subaccountId          String?  @map("subaccount_id")
  amount                Decimal  @db.Decimal(14, 2)
  affectsAccountBalance Boolean  @map("affects_account_balance")
  createdAt             DateTime @default(now()) @map("created_at")

  financialOperation FinancialOperation @relation(fields: [financialOperationId], references: [id], onDelete: Cascade)
  account            Account            @relation(fields: [accountId], references: [id])
  subaccount         Subaccount?        @relation(fields: [subaccountId], references: [id])

  @@index([financialOperationId])
  @@index([accountId])
  @@index([subaccountId])
  @@map("ledger_entry")
}

// @@unique([recurrenceRuleId, expectedDate]) garantit l'idempotence de
// génération (jamais de doublon d'occurrence), y compris pour une récurrence
// hebdomadaire ou plusieurs fois par mois — jamais une clé dérivée en string.
model PlannedOperation {
  id               String               @id @default(uuid())
  householdId      String               @map("household_id")
  kind             PlannedOperationKind
  recurrenceRuleId String?              @map("recurrence_rule_id")
  categoryId       String?              @map("category_id")

  financialPlanItemId     String? @map("financial_plan_item_id")
  financialPlanDeadlineId String? @map("financial_plan_deadline_id")

  sourceAccountId         String? @map("source_account_id")
  sourceSubaccountId      String? @map("source_subaccount_id")
  destinationAccountId    String? @map("destination_account_id")
  destinationSubaccountId String? @map("destination_subaccount_id")

  expectedAmount Decimal  @map("expected_amount") @db.Decimal(14, 2)
  expectedDate   DateTime @map("expected_date") @db.Date
  label          String

  status              PlannedOperationStatus @default(PENDING)
  realizedOperationId String?                @unique @map("realized_operation_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  household      Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recurrenceRule RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id])
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  financialPlanItem     FinancialPlanItem?     @relation(fields: [financialPlanItemId], references: [id])
  financialPlanDeadline FinancialPlanDeadline? @relation(fields: [financialPlanDeadlineId], references: [id])

  sourceAccount         Account?    @relation("PlannedSourceAccount", fields: [sourceAccountId], references: [id])
  sourceSubaccount      Subaccount? @relation("PlannedSourceSubaccount", fields: [sourceSubaccountId], references: [id])
  destinationAccount    Account?    @relation("PlannedDestinationAccount", fields: [destinationAccountId], references: [id])
  destinationSubaccount Subaccount? @relation("PlannedDestinationSubaccount", fields: [destinationSubaccountId], references: [id])

  realizedOperation FinancialOperation? @relation(fields: [realizedOperationId], references: [id])

  @@unique([recurrenceRuleId, expectedDate])
  @@index([householdId])
  @@map("planned_operation")
}

// amount_reimbursed et status ne sont JAMAIS stockés — toujours dérivés de
// SUM(medical_reimbursements.amount) / comparaison à amount_engaged (cf. rapport).
model MedicalClaim {
  id                String    @id @default(uuid())
  householdId       String    @map("household_id")
  sourceOperationId String    @map("source_operation_id")
  subaccountId      String?   @map("subaccount_id")
  label             String
  amountEngaged     Decimal   @map("amount_engaged") @db.Decimal(14, 2)
  closedAt          DateTime? @map("closed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  household       Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  sourceOperation FinancialOperation     @relation(fields: [sourceOperationId], references: [id])
  subaccount      Subaccount?            @relation(fields: [subaccountId], references: [id])
  reimbursements  MedicalReimbursement[]

  @@index([householdId])
  @@map("medical_claim")
}

model MedicalReimbursement {
  id                     String   @id @default(uuid())
  claimId                String   @map("claim_id")
  amount                 Decimal  @db.Decimal(14, 2)
  date                   DateTime @db.Date
  operationId            String   @map("operation_id")
  allocationSubaccountId String?  @map("allocation_subaccount_id")
  createdAt              DateTime @default(now()) @map("created_at")

  claim                MedicalClaim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  operation            FinancialOperation @relation(fields: [operationId], references: [id])
  allocationSubaccount Subaccount?        @relation("ReimbursementAllocationSubaccount", fields: [allocationSubaccountId], references: [id])

  @@index([claimId])
  @@map("medical_reimbursement")
}
